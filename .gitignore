# Dependencies
node_modules/

# Single lockfile lives at the workspace root; a per-package one
# is a `npm install` foot-gun that just adds noise.
package-lock.json

# Expo CLI cache. Contains absolute paths, so it's per-machine.
.expo/

# expo-module-scripts compile output. The published tarball includes
# this (via the `files` field in package.json), but it's regenerated
# by `npm run prepare` so there's no reason to commit it.
build/

# Apple Session SDK sources vendored at install time by
# `scripts/postinstall.js`. The destination tree is reproducible
# from `apple_session_sdk_tag` in package.json, so it stays out of
# git. `tmp/` and the staging zip are also extraction artefacts.
ios/sdk/
ios/sdk/tmp/
*.zip

# Standard JS / TypeScript
*.tsbuildinfo
.tscache/

# Xcode
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata
*.xccheckout
*.moved-aside
DerivedData
*.hmap
*.ipa
*.xcuserstate

# Android / IDEs
.gradle/
.cxx/
.idea/
.classpath
.project
.settings/
local.properties

# OS
.DS_Store
