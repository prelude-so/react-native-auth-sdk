{
  "name": "@prelude.so/react-native-auth-sdk",
  "version": "0.2.1",
  "description": "Prelude Auth SDK for React Native — OTP login, password login, refresh, step-up, and signed sessions on iOS and Android.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "expo-module build",
    "clean": "expo-module clean",
    "lint": "expo-module lint",
    "test": "expo-module test --selectProjects Node Web",
    "prepare": "expo-module prepare",
    "prepublishOnly": "expo-module prepublishOnly",
    "postinstall": "node scripts/postinstall.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "prelude",
    "auth",
    "session",
    "PreludeReactNativeAuthSdk"
  ],
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "android/build.gradle",
    "android/src/main/",
    "build/",
    "expo-module.config.json",
    "ios/*.swift",
    "ios/*.podspec",
    "ios/PrivacyInfo.xcprivacy",
    "scripts/postinstall.js",
    "src/*.ts",
    "src/types/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prelude-so/react-native-auth-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/prelude-so/react-native-auth-sdk/issues"
  },
  "author": "Prelude <hello@prelude.so> (https://github.com/prelude-so)",
  "license": "Apache-2.0",
  "homepage": "https://github.com/prelude-so/react-native-auth-sdk#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/react": "^18.3.0",
    "expo": "~52.0.46",
    "expo-module-scripts": "^4.0.2",
    "react": "^18.3.0",
    "react-native": "0.76.9"
  },
  "peerDependencies": {
    "expo": ">=52.0.0",
    "react": ">=18.2.0",
    "react-native": ">=0.74.0"
  },
  "so_prelude": {
    "apple_auth_sdk_tag": "0.3.0",
    "android_auth_sdk_version": "0.3.0",
    "android_signals_sdk_version": "0.5.2"
  },
  "jest": {
    "preset": "expo-module-scripts"
  }
}
