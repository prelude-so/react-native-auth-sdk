{
  "name": "@prelude.so/react-native-auth-sdk",
  "version": "0.6.0",
  "description": "Prelude Auth SDK for React Native \u2014 OTP login, password login, refresh, step-up, and signed sessions on iOS and Android.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./react": {
      "types": "./build/react/index.d.ts",
      "default": "./build/react/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "react": [
        "./build/react/index.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "expo-module build",
    "clean": "expo-module clean",
    "lint": "expo-module lint",
    "test": "expo-module test --selectProjects Node Web",
    "prepare": "expo-module prepare",
    "prepublishOnly": "expo-module prepublishOnly",
    "postinstall": "node scripts/postinstall.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "prelude",
    "auth",
    "session",
    "PreludeReactNativeAuthSdk"
  ],
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "app.plugin.js",
    "android/build.gradle",
    "android/src/main/",
    "build/",
    "expo-module.config.json",
    "ios/*.podspec",
    "ios/*.swift",
    "ios/PrivacyInfo.xcprivacy",
    "scripts/postinstall.js",
    "src/*.ts",
    "src/react/",
    "!src/react/__tests__/",
    "src/types/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prelude-so/react-native-auth-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/prelude-so/react-native-auth-sdk/issues"
  },
  "author": "Prelude <hello@prelude.so> (https://github.com/prelude-so)",
  "license": "Apache-2.0",
  "homepage": "https://github.com/prelude-so/react-native-auth-sdk#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/react": "^19.0.0",
    "expo": "~53.0.27",
    "expo-module-scripts": "^4.1.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "0.79.6",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "expo": ">=52.0.0",
    "react": ">=18.2.0",
    "react-native": ">=0.74.0"
  },
  "so_prelude": {
    "apple_auth_sdk_tag": "0.6.0",
    "android_auth_sdk_version": "0.6.0",
    "android_signals_sdk_version": "0.5.2",
    "android_browser_version": "1.8.0"
  },
  "jest": {
    "preset": "expo-module-scripts"
  }
}
